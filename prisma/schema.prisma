generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String
  passwordHash        String?
  avatarUrl           String?
  role                String   @default("SALES_PERSON")
  currentConferenceId String?
  isActive            Boolean  @default(true)
  inviteToken         String?  @unique
  inviteExpiry        DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sentInvitations Invitation[]
  assignments     ConferenceAssignment[]
  capturedLeads   Lead[]
  assignedTrips   TripOpportunity[]
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id         String    @id @default(cuid())
  email      String
  role       String    @default("SALES_PERSON")
  token      String    @unique @default(cuid())
  status     String    @default("PENDING")
  expiresAt  DateTime
  sentById   String
  sentBy     User      @relation(fields: [sentById], references: [id])
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
}

model SystemConfig {
  id            String   @id @default("singleton")
  aiProvider    String   @default("ANTHROPIC")
  aiApiKey      String?
  hubspotMode   String   @default("MOCK")
  hubspotApiKey String?
  serperApiKey  String?
  updatedAt     DateTime @updatedAt
}

model Conference {
  id                String   @id @default(cuid())
  name              String   @unique
  website           String?
  startDate         DateTime
  endDate           DateTime
  city              String
  country           String
  lat               Float?
  lng               Float?
  verticals         String   @default("[]")
  buyerPersonas     String   @default("[]")
  estimatedAudience Int?
  icpScore          Float    @default(0)
  status            String   @default("DRAFT")
  source            String   @default("MANUAL")
  notes             String?
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Planning fields
  isHidden          Boolean  @default(false)

  attendingStatus   String   @default("EVALUATING")
  campaignStatus    String   @default("NOT_STARTED")
  outboundStatus    String   @default("NOT_STARTED")
  meetingsScheduled Int      @default(0)
  backupOwner       String?

  assignments    ConferenceAssignment[]
  leads          ConferenceLead[]
  targetAccounts TargetAccount[]
}

model TargetAccount {
  id              String    @id @default(cuid())
  conferenceId    String
  company         String
  contactName     String?
  contactRole     String?
  notes           String?
  priority        String    @default("MEDIUM")
  status          String    @default("TO_MEET")
  createdAt       DateTime  @default(now())

  website         String?
  description     String?
  industry        String?
  icpFit          String?
  fxRelevance     String?
  relevanceReason String?
  companySize     String?
  isPublic        Boolean   @default(false)
  regions         String?
  confidence      String?   @default("MEDIUM")
  dataSource      String?
  lastEnrichedAt  DateTime?

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)
}

model ConferenceAssignment {
  id           String   @id @default(cuid())
  conferenceId String
  userId       String
  role         String   @default("PRIMARY")
  assignedById String?
  assignedAt   DateTime @default(now())
  myFocus      String?

  conference Conference @relation(fields: [conferenceId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([conferenceId, userId])
}

model TripOpportunity {
  id            String   @id @default(cuid())
  name          String
  clusterReason String?
  assignedToId  String?
  calculatedAt  DateTime @default(now())
  conferenceIds String   @default("[]")

  assignedTo User? @relation(fields: [assignedToId], references: [id])
}

model Lead {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  email              String?
  phone              String?
  company            String
  jobTitle           String?
  linkedinUrl        String?
  notes              String?
  cardImageUrl       String?
  rawCardText        String?
  icpScore           Float?
  tags               String    @default("[]")
  followUpDraft      String?
  hubspotContactId   String?
  capturedById       String
  capturedAt         DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  currentCompany     String?
  previousCompany    String?
  previousJobTitle   String?
  aiSummary          String?
  aiSummaryAt        DateTime?
  relationshipStatus String?

  capturedBy         User               @relation(fields: [capturedById], references: [id])
  conferences        ConferenceLead[]
  matchesA           ContactMatch[]     @relation("MatchA")
  matchesB           ContactMatch[]     @relation("MatchB")
  syncLogs           HubspotSyncLog[]
  personEnrichments  PersonEnrichment[]
}

model ConferenceLead {
  id              String   @id @default(cuid())
  conferenceId    String
  leadId          String
  engagementNotes String?
  capturedAt      DateTime @default(now())
  companyAtTime   String?
  jobTitleAtTime  String?

  conference Conference @relation(fields: [conferenceId], references: [id])
  lead       Lead       @relation(fields: [leadId], references: [id])

  @@unique([conferenceId, leadId])
}

model ContactMatch {
  id         String    @id @default(cuid())
  leadAId    String
  leadBId    String
  confidence Float
  resolvedAs String    @default("PENDING")
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  leadA Lead @relation("MatchA", fields: [leadAId], references: [id])
  leadB Lead @relation("MatchB", fields: [leadBId], references: [id])
}

model HubspotSyncLog {
  id         String   @id @default(cuid())
  leadId     String
  status     String
  response   String?
  isMockSync Boolean  @default(false)
  syncedAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

// Global company knowledge layer — shared across all conferences
model CompanyEnrichment {
  id             String   @id @default(cuid())
  company        String   @unique  // normalized lowercase
  displayName    String            // original casing as first seen
  whatTheyDo     String?
  market         String?
  businessType   String?
  fxRelevance    String?
  grainRelevance String?
  keyPeople      String?
  salesAngle     String?
  website        String?
  dataSource     String   @default("AI")
  confidence     String   @default("MEDIUM")
  lastEnrichedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Person-level enrichment — stored per (company, jobTitle) pair
model PersonEnrichment {
  id              String   @id @default(cuid())
  company         String            // normalized lowercase
  jobTitle        String            // normalized lowercase
  firstName       String?
  lastName        String?
  linkedinUrl     String?
  sourceUrl       String?           // URL where person was found (web search result)
  needsReview     Boolean  @default(false)  // true when confidence is uncertain
  summary         String?
  warmth          String?           // WARM | COLD | QUALIFIED
  previousContext String?           // filled when matched to internal lead
  dataSource      String   @default("AI")
  confidence      String   @default("MEDIUM")  // HIGH | MEDIUM | LOW
  matchedLeadId   String?           // linked to existing Lead when recognized internally
  lastEnrichedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  matchedLead     Lead?    @relation(fields: [matchedLeadId], references: [id])

  @@unique([company, jobTitle])
}

