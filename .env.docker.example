# ── Required ──────────────────────────────────────────────────────────────────

# NextAuth session signing key — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# Public URL of the app (no trailing slash)
# Local:  http://localhost:3000
# Cloud:  https://your-app.railway.app  (or render.com, fly.dev, etc.)
NEXTAUTH_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# docker-compose.yml overrides this to file:/data/grain.db automatically.
# Only set here if deploying without docker-compose.
# DATABASE_URL=file:/data/grain.db

# ── AI enrichment (optional) ─────────────────────────────────────────────────
# Leave blank to use rule-based ICP scoring (works without an AI key).
# Configure in the Admin → Settings UI after first login instead.
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── HubSpot (optional) ────────────────────────────────────────────────────────
# Default is Mock mode (no real HubSpot calls). Configure in Admin → Settings UI.
# HUBSPOT_API_KEY=pat-na1-...

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Leave blank — password auth works without OAuth.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
