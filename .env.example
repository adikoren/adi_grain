# ── Database ──────────────────────────────────────────────────────────────────
# SQLite file path. In Docker, /data is a persistent volume.
DATABASE_URL="file:/data/grain.db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Production URL of the app (no trailing slash)
NEXTAUTH_URL="https://your-app.railway.app"

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Create credentials at https://console.developers.google.com
# Authorized redirect URI: https://your-app.railway.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── AI (configured in Admin Settings UI, stored in DB) ───────────────────────
# You can also set these as env vars to pre-populate; UI values take precedence.
# AI_API_KEY=""
# AI_PROVIDER="OPENAI"  # or ANTHROPIC

# ── HubSpot (configured in Admin Settings UI) ─────────────────────────────────
# HUBSPOT_API_KEY=""
